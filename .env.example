# Copy to backend/.env and fill in. Never commit .env.

# ---- LLM providers (all free tiers, no card) ---------------------------------
# Gemini: https://aistudio.google.com  → Get API key.  Primary for heavy work.
GEMINI_API_KEY=
# Groq:   https://console.groq.com/keys                Fast small calls.
GROQ_API_KEY=
# NVIDIA: https://build.nvidia.com → any model → Get API Key.  Overflow capacity.
NVIDIA_API_KEY=

# ---- LLM router tuning (optional; defaults in models_config.py) -------------
# Model ids. Check what your key can see with the curl commands in models_config.py.
# GEMINI_HEAVY_MODEL=gemini-2.5-flash
# GEMINI_LITE_MODEL=gemini-2.5-flash-lite
# GROQ_TEXT_MODEL=qwen/qwen3.8-27b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_VISION_FALLBACK_MODEL=            # off unless set; previous default was retired
# NVIDIA_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b
#
# Which deployments serve which work, in order (names are the keys in DEPLOYMENTS).
# LLM_TIER_HEAVY=gemini-flash,nvidia-text,groq-text
# LLM_TIER_FAST=groq-fast,gemini-lite,nvidia-text
# LLM_TIER_VISION=gemini-flash,groq-text
# LLM_TIER_AGENT=gemini-flash,nvidia-text,groq-text
#
# Per-deployment limit overrides: LLM_<NAME>_RPM / _TPM / _RPD, NAME upper-case with - → _
# LLM_GEMINI_FLASH_RPM=10
# LLM_GROQ_TPD=200000                    # Groq's org-wide tokens per day
# LLM_SAFETY=0.85                        # spend only this fraction of each published limit
# LLM_MAX_WAIT_S=20                      # wait for a busy window only if it frees within this
# LLM_TIMEOUT_S=90
# LLM_DISABLE=                           # e.g. groq-text,nvidia-text
# AGENT_MAX_TOKENS=1500

# ---- Vector store ------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_URI=

# ---- Supabase ----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PASSWORD=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ---- Auth --------------------------------------------------------------------
JWT_SECRET=

# ---- Email (OTP) -------------------------------------------------------------
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=
MAIL_PORT=
BREVO_API_KEY=

# ---- Job search --------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
